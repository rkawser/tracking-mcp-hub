{
  "mcpServers": {
    "meta-ads": { "command": "npx", "args": ["-y", "mcp-remote", "https://mcp.facebook.com/ads"] },
    "snapchat-ads": { "command": "npx", "args": ["-y", "mcp-remote", "https://mcp.snapchat.com/ads"] },
    "gtm-stape": { "command": "npx", "args": ["-y", "mcp-remote", "https://gtm-mcp.stape.ai/mcp"] },
    "google-ads": {
      "command": "pipx",
      "args": ["run", "--spec", "git+https://github.com/googleads/google-ads-mcp.git", "google-ads-mcp"],
      "env": {
        "GOOGLE_PROJECT_ID": "YOUR_GCP_PROJECT_ID",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "YOUR_DEVELOPER_TOKEN",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "MCC_ID_OPTIONAL",
        "GOOGLE_APPLICATION_CREDENTIALS": "/path/to/credentials.json"
      }
    },
    "google-analytics": {
      "command": "pipx",
      "args": ["run", "analytics-mcp"],
      "env": {
        "GOOGLE_PROJECT_ID": "YOUR_GCP_PROJECT_ID",
        "GOOGLE_APPLICATION_CREDENTIALS": "/path/to/credentials.json"
      }
    },
    "shopify-dev": { "command": "npx", "args": ["-y", "@shopify/dev-mcp@latest"] }
  }
}
